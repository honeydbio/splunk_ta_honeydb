{
    "pages": {
        "configuration": {
            "tabs": [
                {
                    "name": "account",
                    "table": {
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ],
                        "header": [
                            {
                                "label": "Name",
                                "field": "name"
                            },
                            {
                                "label": "API ID",
                                "field": "api_id"
                            },
                            {
                                "label": "Subscription",
                                "field": "subscription"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Account Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of account name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for the account.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "API ID",
                            "field": "api_id",
                            "help": "Your HoneyDB API ID (honeydb.io > Threat Information > API).",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of API ID should be between 1 and 200",
                                    "minLength": 1,
                                    "maxLength": 200
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "API Key",
                            "field": "api_key",
                            "help": "Your HoneyDB API Key. Stored encrypted.",
                            "required": true,
                            "encrypted": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of API Key should be between 1 and 200",
                                    "minLength": 1,
                                    "maxLength": 200
                                }
                            ]
                        },
                        {
                            "type": "singleSelect",
                            "label": "Subscription",
                            "field": "subscription",
                            "defaultValue": "community",
                            "help": "HoneyDB subscription plan. Gold pulls all sensor data; community pulls your own sensors' data.",
                            "required": true,
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "value": "community",
                                        "label": "Community"
                                    },
                                    {
                                        "value": "gold",
                                        "label": "Gold"
                                    }
                                ]
                            }
                        }
                    ],
                    "title": "Accounts"
                },
                {
                    "type": "loggingTab"
                }
            ],
            "title": "Configuration",
            "description": "Configure your HoneyDB API account"
        },
        "inputs": {
            "services": [
                {
                    "name": "honeydb_badhosts",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Input Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for the data input.",
                            "required": true
                        },
                        {
                            "type": "interval",
                            "label": "Interval",
                            "defaultValue": "1800",
                            "field": "interval",
                            "help": "Polling interval in seconds (the bad-hosts feed updates every 30 minutes).",
                            "required": true
                        },
                        {
                            "type": "index",
                            "field": "index",
                            "defaultValue": "honeydb",
                            "label": "Index"
                        },
                        {
                            "type": "singleSelect",
                            "label": "Account to use",
                            "options": {
                                "referenceName": "account"
                            },
                            "help": "HoneyDB account to use for this input.",
                            "field": "account",
                            "required": true
                        }
                    ],
                    "title": "HoneyDB Bad Hosts",
                    "inputHelperModule": "honeydb_badhosts_helper"
                },
                {
                    "name": "honeydb_sensor_data",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "validators": [
                                {
                                    "type": "regex",
                                    "errorMsg": "Input Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                                    "pattern": "^[a-zA-Z]\\w*$"
                                },
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "name",
                            "help": "A unique name for the data input.",
                            "required": true
                        },
                        {
                            "type": "interval",
                            "label": "Interval",
                            "defaultValue": "60",
                            "field": "interval",
                            "help": "Polling interval in seconds.",
                            "required": true
                        },
                        {
                            "type": "index",
                            "field": "index",
                            "defaultValue": "honeydb",
                            "label": "Index"
                        },
                        {
                            "type": "singleSelect",
                            "label": "Account to use",
                            "options": {
                                "referenceName": "account"
                            },
                            "help": "HoneyDB account to use for this input.",
                            "field": "account",
                            "required": true
                        }
                    ],
                    "title": "HoneyDB Sensor Data",
                    "inputHelperModule": "honeydb_sensor_data_helper"
                }
            ],
            "title": "Inputs",
            "description": "Manage HoneyDB data inputs",
            "table": {
                "actions": [
                    "edit",
                    "delete",
                    "clone"
                ],
                "header": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Interval",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Status",
                        "field": "disabled"
                    }
                ],
                "moreInfo": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Interval",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Status",
                        "field": "disabled",
                        "mapping": {
                            "true": "Inactive",
                            "false": "Active"
                        }
                    }
                ]
            }
        },
        "dashboard": {
            "panels": [
                {
                    "name": "default"
                }
            ]
        }
    },
    "meta": {
        "name": "splunk_ta_honeydb",
        "restRoot": "splunk_ta_honeydb",
        "version": "3.0.0",
        "displayName": "Splunk TA for HoneyDB",
        "schemaVersion": "0.0.10",
        "supportedThemes": [
            "light",
            "dark"
        ]
    }
}
